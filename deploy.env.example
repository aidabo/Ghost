# Copy this file to deploy.env (gitignored) on the build host.
# deploy.sh sources deploy.env before the AWS account guard.

# AWS profile used for the S3 upload and the SSM Parameter Store writes.
# テナントごとの profile / account は deploy-targets.json の各テナントに書く
# （未設定ならここの全体値を使う）。
DEPLOY_AWS_PROFILE=60-think

# Required for build/upload (fail closed): the account the profile must resolve to.
# Get it from the tenant secrets, e.g.
#   grep '^AWS_ACCOUNT_ID=' <frontend-repo>/tenants/60-think/deploy/secrets/60-think.env
# 値をこの tracked example には書かない（実値は gitignored の deploy.env にだけ）。
DEPLOY_AWS_ACCOUNT=

# SSM parameter names come from ssmParam in deploy-targets.json (only the
# selected tenants are updated). DEPLOY_SSM_PARAMS is no longer used.

# Tenant names for the SSM parameters to update (space-separated; default both).
# The Docker image and S3 artifact are shared: ghost:<VERSION> /
# ghost-<VERSION>.tar.gz.
# TENANTS="60-think thinkestate"

# Set to 0 to skip the SSM write (test builds).
WRITE_SSM_PARAM=1
